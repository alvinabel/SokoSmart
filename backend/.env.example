# Flask identity + admin service — env example
# Copy to `.env` (not committed) and adjust.

MONGO_URI=mongodb://localhost:27017/agrobasket
MONGO_DB=agrobasket

JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=agrobasket
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=http://localhost:5173

# Bootstrap admin / demo accounts (used by seed.py)
ADMIN_EMAIL=admin@agrobasket.test
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_USERS=true
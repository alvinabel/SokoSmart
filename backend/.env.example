# Flask identity + admin service — env example
# Copy to `.env` (not committed) and adjust.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrobasket
DB_POOL_MAX=10

JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=agrobasket
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=http://localhost:5173

# Bootstrap admin / demo accounts (used by seed.py)
ADMIN_EMAIL=admin@agrobasket.test
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_USERS=true

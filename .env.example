# Root .env for docker-compose (copy to .env and adjust)

# --- PostgreSQL (local docker-compose) ---
POSTGRES_USER=agrobasket
POSTGRES_PASSWORD=agrobasket
POSTGRES_DB=agrobasket

# --- Shared service config (read by backend/ and api/) ---
# In docker compose "postgres" resolves to the postgres container hostname.
DATABASE_URL=postgresql://agrobasket:agrobasket@postgres:5432/agrobasket
DB_POOL_MAX=10
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173

# --- Bootstrap admin (used by seed.py) ---
ADMIN_EMAIL=admin@agrobasket.test
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_USERS=true
SEED_DEMO_ITEMS=true

# --- Compose ports (change if busy) ---
FRONTEND_PORT=5173
BACKEND_PORT=5001
API_PORT=8000
POSTGRES_PORT=5432

# --- Supabase (Postgres). Free tier. ---
# For production, point DATABASE_URL at Supabase's connection string, e.g.
#   DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# `supabase/schema.sql` provisions the same tables as shared/schema.py.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=listings

# Frontend (Vite/Vercel) — the anon key is public and safe to expose in the bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

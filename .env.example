# Root .env for docker-compose (copy to .env and adjust)

# --- MongoDB ---
MONGO_ROOT_USER=mongoroot
MONGO_ROOT_PASSWORD=mongorootpass
MONGO_INITDB_DATABASE=agrobasket

# --- Shared service config (read by backend/ and api/) ---
# In docker compose "mongo" resolves to the mongo container hostname.
MONGO_URI=mongodb://mongo:27017/agrobasket
MONGO_DB=agrobasket
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173

# --- Bootstrap admin (used by seed.py) ---
ADMIN_EMAIL=admin@agrobasket.test
ADMIN_PASSWORD=Admin@12345

# --- Compose ports (change if busy) ---
FRONTEND_PORT=5173
BACKEND_PORT=5001
API_PORT=8000
MONGO_PORT=27017

# --- Supabase (Auth + Postgres + Storage + Realtime). Free tier. ---
# Target architecture: Supabase is the source of truth for identity and data.
# `supabase/schema.sql` provisions the tables, RLS and the `listings` bucket.
# The JWT_SECRET / REFRESH_* keys above are LEGACY — still read by the current
# Python services but superseded once the app moves to Supabase Auth (Phase B).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=listings

# Frontend (Vite/Vercel) — the anon key is public and safe to expose in the bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
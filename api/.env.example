# FastAPI marketplace service — env example
# Copy to `.env` (not committed) and adjust.

MONGO_URI=mongodb://localhost:27017/agrobasket
MONGO_DB=agrobasket

JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=agrobasket

CORS_ORIGINS=http://localhost:5173

# Seed demo content (api/seed.py)
SEED_DEMO_ITEMS=true
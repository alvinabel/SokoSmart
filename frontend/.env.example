# Frontend env example — copy to `frontend/.env.local`
# The Flask identity service (auth) and FastAPI marketplace API (market) are separate.

VITE_AUTH_API_URL=http://localhost:5001
VITE_MARKET_API_URL=http://localhost:8000

# In production (Vercel) set these to your deployed API roots, e.g.
# VITE_AUTH_API_URL=https://agrobasket-auth.onrender.com
# VITE_MARKET_API_URL=https://agrobasket-api.onrender.com